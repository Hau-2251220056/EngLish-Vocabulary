// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  USER
  ADMIN
}

enum XP_REWARD_TYPE {
  SRS_INITIAL
  QUIZ_FIRST_CORRECT
  SRS_DUE_REVIEW
}

enum LEARNING_SESSION_MODE {
  NORMAL
  SRS
  QUIZ
}

enum LEARNING_SESSION_STATUS {
  ACTIVE
  COMPLETED
}

enum SESSION_ITEM_EVIDENCE {
  NORMAL_REVEALED
  SRS_HARD
  SRS_GOOD
  SRS_EASY
  QUIZ_CORRECT
  QUIZ_INCORRECT
}

model USER {
  id                                   String                                @id @default(uuid()) @db.Uuid
  email                                String                                @unique @db.VarChar(255)
  password_hash                        String                                @db.Text
  display_name                         String                                @db.VarChar(100)
  avatar_url                           String?                               @db.Text
  role                                 USER_ROLE                             @default(USER)
  is_active                            Boolean                               @default(true)
  total_xp                             Int                                   @default(0)
  daily_xp_goal                        Int                                   @default(50)
  created_at                           DateTime                              @default(now())
  updated_at                           DateTime                              @updatedAt
  auth_sessions                        AUTH_SESSION[]
  vocabulary_sets                      VOCABULARY_SET[]
  owned_vocabularies                   VOCABULARY[]                          @relation("VocabularyOwner")
  private_vocabulary_create_operations PRIVATE_VOCABULARY_CREATE_OPERATION[] @relation("PrivateVocabularyCreateOperationOwner")
  learning_progress                    LEARNING_PROGRESS[]
  xp_rewards                           XP_REWARD[]
  learning_sessions                    LEARNING_SESSION[]
  streak_days                          STREAK_DAY[]
}

model AUTH_SESSION {
  id                      String   @id @default(uuid()) @db.Uuid
  user_id                 String   @db.Uuid
  session_identifier_hash String   @unique @db.VarChar(64)
  created_at              DateTime @default(now())
  expires_at              DateTime
  user                    USER     @relation(fields: [user_id], references: [id])
}

model TOPIC {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  vocabulary_sets VOCABULARY_SET[]
}

model VOCABULARY {
  id                        String                                @id @default(uuid()) @db.Uuid
  owner_id                  String?                               @db.Uuid
  word                      String                                @db.VarChar(100)
  phonetic                  String?                               @db.VarChar(100)
  pronunciation_url         String?                               @db.VarChar(2048)
  created_at                DateTime                              @default(now())
  updated_at                DateTime                              @updatedAt
  owner                     USER?                                 @relation("VocabularyOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  meanings                  VOCABULARY_MEANING[]
  vocabulary_items          VOCABULARY_SET_ITEM[]
  learning_progress         LEARNING_PROGRESS[]
  private_create_operations PRIVATE_VOCABULARY_CREATE_OPERATION[] @relation("PrivateVocabularyCreateOperationVocabulary")
  xp_rewards                XP_REWARD[]
}

model VOCABULARY_MEANING {
  id             String               @id @default(uuid()) @db.Uuid
  vocabulary_id  String               @db.Uuid
  part_of_speech String               @db.VarChar(50)
  meaning_vi     String               @db.VarChar(500)
  context        String?              @db.VarChar(500)
  cefr_level     String?              @db.Text
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  vocabulary     VOCABULARY           @relation(fields: [vocabulary_id], references: [id], onDelete: Cascade)
  examples       VOCABULARY_EXAMPLE[]
}

model VOCABULARY_EXAMPLE {
  id         String             @id @default(uuid()) @db.Uuid
  meaning_id String             @db.Uuid
  example_en String             @db.VarChar(1000)
  example_vi String?            @db.VarChar(1000)
  created_at DateTime           @default(now())
  meaning    VOCABULARY_MEANING @relation(fields: [meaning_id], references: [id], onDelete: Cascade)
}

model VOCABULARY_SET {
  id                                   String                                @id @default(uuid()) @db.Uuid
  topic_id                             String?                               @db.Uuid
  owner_id                             String                                @db.Uuid
  name                                 String                                @db.VarChar(100)
  description                          String?                               @db.VarChar(500)
  cefr_level                           String?                               @db.Text
  cover_image_url                      String?                               @db.VarChar(2048)
  cover_storage_key                    String?                               @db.VarChar(512)
  is_public                            Boolean
  created_at                           DateTime                              @default(now())
  updated_at                           DateTime                              @updatedAt
  topic                                TOPIC?                                @relation(fields: [topic_id], references: [id], onDelete: Restrict)
  owner                                USER                                  @relation(fields: [owner_id], references: [id], onDelete: Restrict)
  items                                VOCABULARY_SET_ITEM[]
  private_vocabulary_create_operations PRIVATE_VOCABULARY_CREATE_OPERATION[] @relation("PrivateVocabularyCreateOperationSet")
  learning_sessions                    LEARNING_SESSION[]
}

model VOCABULARY_SET_ITEM {
  id                String         @id @default(uuid()) @db.Uuid
  vocabulary_set_id String         @db.Uuid
  vocabulary_id     String         @db.Uuid
  position          Int
  created_at        DateTime       @default(now())
  vocabulary_set    VOCABULARY_SET @relation(fields: [vocabulary_set_id], references: [id], onDelete: Cascade)
  vocabulary        VOCABULARY     @relation(fields: [vocabulary_id], references: [id], onDelete: Restrict)

  @@unique([vocabulary_set_id, vocabulary_id])
  @@unique([vocabulary_set_id, position])
}

model LEARNING_PROGRESS {
  id               String     @id @default(uuid()) @db.Uuid
  user_id          String     @db.Uuid
  vocabulary_id    String     @db.Uuid
  status           String     @db.Text
  review_count     Int        @default(0)
  revision         Int        @default(0)
  last_reviewed_at DateTime?
  last_event_id    String?    @db.Uuid
  next_review_at   DateTime?
  interval_days    Int?
  ease_factor      Decimal?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  user             USER       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  vocabulary       VOCABULARY @relation(fields: [vocabulary_id], references: [id], onDelete: Restrict)

  @@unique([user_id, vocabulary_id])
}

model XP_REWARD {
  id              String         @id @default(uuid()) @db.Uuid
  user_id         String         @db.Uuid
  vocabulary_id   String         @db.Uuid
  reward_type     XP_REWARD_TYPE
  reward_cycle    Int
  source_event_id String         @db.Uuid
  xp_amount       Int
  created_at      DateTime       @default(now())
  user            USER           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vocabulary      VOCABULARY     @relation(fields: [vocabulary_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([user_id, vocabulary_id, reward_type, reward_cycle])
  @@unique([user_id, source_event_id])
  @@index([vocabulary_id])
}

model LEARNING_SESSION {
  id                  String                  @id @default(uuid()) @db.Uuid
  user_id             String                  @db.Uuid
  vocabulary_set_id   String?                 @db.Uuid
  set_id_snapshot     String                  @db.Uuid
  mode                LEARNING_SESSION_MODE
  status              LEARNING_SESSION_STATUS @default(ACTIVE)
  create_operation_id String                  @db.Uuid
  snapshot_size       Int
  created_at          DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @db.Timestamp(3)
  expires_at          DateTime                @db.Timestamp(3)
  completed_at        DateTime?               @db.Timestamp(3)
  completion_event_id String?                 @db.Uuid
  user                USER                    @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vocabulary_set      VOCABULARY_SET?         @relation(fields: [vocabulary_set_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items               LEARNING_SESSION_ITEM[]
  streak_days         STREAK_DAY[]

  @@unique([user_id, create_operation_id])
  @@unique([user_id, completion_event_id])
  @@index([user_id, status, expires_at])
  @@index([vocabulary_set_id])
}

model LEARNING_SESSION_ITEM {
  id                String                         @id @default(uuid()) @db.Uuid
  session_id        String                         @db.Uuid
  vocabulary_id     String                         @db.Uuid
  position          Int
  evidence          SESSION_ITEM_EVIDENCE?
  evidence_event_id String?                        @unique @db.Uuid
  evidence_at       DateTime?                      @db.Timestamp(3)
  session           LEARNING_SESSION               @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  srs_receipts      LEARNING_SESSION_SRS_RECEIPT[]

  @@unique([session_id, vocabulary_id])
  @@unique([session_id, position])
}

model LEARNING_SESSION_SRS_RECEIPT {
  event_id          String                @id @db.Uuid
  session_item_id   String                @db.Uuid
  rating            String                @db.VarChar(5)
  expected_revision Int
  accepted_revision Int
  accepted_at       DateTime              @db.Timestamp(3)
  session_item      LEARNING_SESSION_ITEM @relation(fields: [session_item_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([session_item_id, accepted_revision])
}

model STREAK_DAY {
  id               String            @id @default(uuid()) @db.Uuid
  user_id          String            @db.Uuid
  activity_date    DateTime          @db.Date
  first_session_id String?           @db.Uuid
  created_at       DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @db.Timestamp(3)
  user             USER              @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  first_session    LEARNING_SESSION? @relation(fields: [first_session_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([user_id, activity_date])
}

model PRIVATE_VOCABULARY_CREATE_OPERATION {
  operation_id        String         @id @db.Uuid
  owner_id            String         @db.Uuid
  vocabulary_set_id   String         @db.Uuid
  vocabulary_id       String         @db.Uuid
  request_fingerprint String         @db.Text
  created_at          DateTime       @default(now())
  owner               USER           @relation("PrivateVocabularyCreateOperationOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  vocabulary_set      VOCABULARY_SET @relation("PrivateVocabularyCreateOperationSet", fields: [vocabulary_set_id], references: [id], onDelete: Cascade)
  vocabulary          VOCABULARY     @relation("PrivateVocabularyCreateOperationVocabulary", fields: [vocabulary_id], references: [id], onDelete: Restrict)

  @@index([owner_id])
  @@index([vocabulary_set_id])
  @@index([vocabulary_id])
}
