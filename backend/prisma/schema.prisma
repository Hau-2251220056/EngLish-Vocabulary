// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  USER
  ADMIN
}

model USER {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique @db.VarChar(255)
  password_hash     String         @db.Text
  display_name      String         @db.VarChar(100)
  avatar_url        String?        @db.Text
  role              USER_ROLE      @default(USER)
  is_active         Boolean        @default(true)
  total_xp          Int            @default(0)
  daily_xp_goal     Int            @default(50)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  auth_sessions     AUTH_SESSION[]
  vocabulary_sets   VOCABULARY_SET[]
  learning_progress LEARNING_PROGRESS[]
}

model AUTH_SESSION {
  id                       String   @id @default(uuid()) @db.Uuid
  user_id                  String   @db.Uuid
  session_identifier_hash  String   @unique @db.VarChar(64)
  created_at               DateTime @default(now())
  expires_at               DateTime
  user                     USER     @relation(fields: [user_id], references: [id])
}

model TOPIC {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  vocabulary_sets VOCABULARY_SET[]
}

model VOCABULARY {
  id                String                 @id @default(uuid()) @db.Uuid
  word              String                 @db.VarChar(100)
  phonetic          String?                @db.VarChar(100)
  pronunciation_url String?                @db.VarChar(2048)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  meanings          VOCABULARY_MEANING[]
  vocabulary_items  VOCABULARY_SET_ITEM[]
  learning_progress LEARNING_PROGRESS[]
}

model VOCABULARY_MEANING {
  id              String                 @id @default(uuid()) @db.Uuid
  vocabulary_id   String                 @db.Uuid
  part_of_speech  String                 @db.VarChar(50)
  meaning_vi      String                 @db.VarChar(500)
  context         String?                @db.VarChar(500)
  cefr_level      String?                @db.Text
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  vocabulary      VOCABULARY             @relation(fields: [vocabulary_id], references: [id], onDelete: Cascade)
  examples        VOCABULARY_EXAMPLE[]
}

model VOCABULARY_EXAMPLE {
  id          String              @id @default(uuid()) @db.Uuid
  meaning_id  String              @db.Uuid
  example_en  String              @db.VarChar(1000)
  example_vi  String?             @db.VarChar(1000)
  created_at  DateTime            @default(now())
  meaning     VOCABULARY_MEANING  @relation(fields: [meaning_id], references: [id], onDelete: Cascade)
}

model VOCABULARY_SET {
  id          String                @id @default(uuid()) @db.Uuid
  topic_id    String                @db.Uuid
  owner_id    String                @db.Uuid
  name        String                @db.VarChar(100)
  description String?               @db.VarChar(500)
  is_public   Boolean
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  topic       TOPIC                 @relation(fields: [topic_id], references: [id], onDelete: Restrict)
  owner       USER                  @relation(fields: [owner_id], references: [id], onDelete: Restrict)
  items       VOCABULARY_SET_ITEM[]
}

model VOCABULARY_SET_ITEM {
  id                String         @id @default(uuid()) @db.Uuid
  vocabulary_set_id String         @db.Uuid
  vocabulary_id     String         @db.Uuid
  position          Int
  created_at        DateTime       @default(now())
  vocabulary_set    VOCABULARY_SET @relation(fields: [vocabulary_set_id], references: [id], onDelete: Cascade)
  vocabulary        VOCABULARY     @relation(fields: [vocabulary_id], references: [id], onDelete: Restrict)

  @@unique([vocabulary_set_id, vocabulary_id])
  @@unique([vocabulary_set_id, position])
}

model LEARNING_PROGRESS {
  id               String     @id @default(uuid()) @db.Uuid
  user_id          String     @db.Uuid
  vocabulary_id    String     @db.Uuid
  status           String     @db.Text
  review_count     Int        @default(0)
  revision         Int        @default(0)
  last_reviewed_at DateTime?
  last_event_id    String?    @db.Uuid
  next_review_at   DateTime?
  interval_days    Int?
  ease_factor      Decimal?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  user             USER       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  vocabulary       VOCABULARY @relation(fields: [vocabulary_id], references: [id], onDelete: Restrict)

  @@unique([user_id, vocabulary_id])
}
