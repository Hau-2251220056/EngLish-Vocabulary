  "cards": [
    {
      "dot": "emerald",
      "title": "Authoritative backend behavior",
      "items": [
        "Express enforces session and role authorization.",
        "The fixed-stage SRS scheduler and Quiz grading run in backend services.",
        "Learning Progress persists per USER and Vocabulary in PostgreSQL."
      ]
    },
    {
      "dot": "cyan",
      "title": "Speaking boundary",
      "items": [
        "Speaking Practice reuses the authorized NORMAL Learning read.",
        "Browser TTS/STT produces transient transcript classifications only.",
        "Express receives no Speaking audio or transcript and stores no Speaking result."
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberate omissions",
      "items": [
        "No AI pronunciation scoring, phoneme assessment, or Speaking persistence.",
