  "cards": [
    {
      "dot": "emerald",
      "title": "Success boundary",
      "items": [
        "Express sets the raw session token only in an HttpOnly cookie.",
        "PostgreSQL persists only its SHA-256 hash in AUTH_SESSION.",
        "React/Vite stores the public user and redirects to /dashboard.",
        "Authentication uses stateful server-side sessions."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure behavior",
      "items": [
        "Frontend schema failures do not call the backend.",
        "Backend credential failures use one generic 401 response.",
        "No AUTH_SESSION or session cookie is created on failure."
      ]
    }
  ]
