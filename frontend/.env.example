# Local Vite development may override the default http://localhost:5000 backend.
# Vercel requires this build-time value to be an approved HTTPS backend origin.
# Configure Production scope for the Production backend and branch-specific Preview
# values only for branches with matching backend deployments. Do not configure a
# generic Preview fallback; missing or invalid values intentionally fail the build.
# API_PROXY_TARGET=https://backend.example.test
